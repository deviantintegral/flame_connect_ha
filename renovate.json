{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "internalChecksFilter": "strict",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "customDatasources": {
    "ha-python": {
      "description": "Python version of the latest stable Home Assistant release (HA core's master branch tracks stable)",
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/home-assistant/core/master/.python-version",
      "format": "plain"
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the Python version of the latest stable Home Assistant release in setup-python pins",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: ha-python\\s+python-version:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "ha-python",
      "datasourceTemplate": "custom.ha-python"
    },
    {
      "customType": "regex",
      "description": "Track the Home Assistant Python version in the devcontainer image tag",
      "managerFilePatterns": ["/^\\.devcontainer/devcontainer\\.json$/"],
      "matchStrings": [
        "\"mcr\\.microsoft\\.com/devcontainers/python:(?<currentValue>\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "ha-python",
      "datasourceTemplate": "custom.ha-python"
    },
    {
      "customType": "regex",
      "description": "Keep manifest.json requirements in sync with requirements.txt via PyPI",
      "managerFilePatterns": ["/^custom_components/[^/]+/manifest\\.json$/"],
      "matchStrings": [
        "\"(?<depName>[a-zA-Z0-9_.-]+)==(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Track the Python floor in pyproject.toml requires-python (patch updates only; see packageRules)",
      "managerFilePatterns": ["/^pyproject\\.toml$/"],
      "matchStrings": [
        "requires-python\\s*=\\s*\">=(?<currentValue>[\\d.]+)\""
      ],
      "depNameTemplate": "python",
      "datasourceTemplate": "python-version"
    },
    {
      "customType": "regex",
      "description": "Track the Home Assistant Python version in CODESPACES.md prose",
      "managerFilePatterns": ["/^docs/development/CODESPACES\\.md$/"],
      "matchStrings": [
        "Python (?<currentValue>[\\d.]+) environment"
      ],
      "depNameTemplate": "ha-python",
      "datasourceTemplate": "custom.ha-python"
    },
    {
      "customType": "regex",
      "description": "Track the Home Assistant Python version in workflow venv cache keys",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.yml$/"],
      "matchStrings": [
        "ha-venv-.*-py(?<currentValue>\\d+\\.\\d+)-"
      ],
      "depNameTemplate": "ha-python",
      "datasourceTemplate": "custom.ha-python"
    }
  ],
  "automerge": true,
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchDepNames": ["homeassistant"],
      "enabled": false,
      "description": "Home Assistant version should match the homeassistant key in hacs.json"
    },
    {
      "description": "HA Python: track major.minor only; plain datasource has no timestamps so skip release age; review before merging",
      "matchDatasources": ["custom.ha-python"],
      "extractVersion": "^(?<version>\\d+\\.\\d+)",
      "minimumReleaseAge": null,
      "automerge": false,
      "prBodyNotes": [
        "⚠️ **Do not automerge.** Home Assistant has moved to a new Python minor version. Also bump `requires-python` in `pyproject.toml` by hand; Renovate only proposes patch updates there."
      ]
    },
    {
      "description": "Python version is tracked via ha-python; ignore the built-in extraction from setup-python and the devcontainer image",
      "matchManagers": ["github-actions", "devcontainer"],
      "matchDepNames": ["python", "mcr.microsoft.com/devcontainers/python"],
      "enabled": false
    },
    {
      "description": "requires-python floor: allow patch bumps only; minor bumps follow Home Assistant via ha-python",
      "matchDatasources": ["python-version"],
      "matchDepNames": ["python"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": "requires-python floor: review before merging",
      "matchDatasources": ["python-version"],
      "matchDepNames": ["python"],
      "automerge": false
    },
    {
      "matchDepNames": ["flameconnect"],
      "minimumReleaseAge": "0 days",
      "description": "Immediately automerge flameconnect library updates without the default delay"
    },
    {
      "description": "Tagged action releases: cooldown, then automerge",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "minimumReleaseAge": "3 days",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Major action bumps: cooldown, manual review",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "Pure digest moves: no timestamp available, always review",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest", "pinDigest", "pin"],
      "automerge": false,
      "dependencyDashboardApproval": true
    }
  ]
}
